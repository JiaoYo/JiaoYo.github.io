<script setup lang="ts">
import { ref } from 'vue';
import { onLoad, onUnload } from '@dcloudio/uni-app';

const scannerRef = ref<any>(null);
let scanResultHandled = false;
let scannerActive = false;
let torchEnabled = false;

const scanFilters = [
    plus.barcode.QR!, plus.barcode.CODE128!, plus.barcode.CODE39!, plus.barcode.CODE93!,
    plus.barcode.EAN13!, plus.barcode.EAN8!, plus.barcode.UPCA!,
    plus.barcode.UPCE!, plus.barcode.ITF!, plus.barcode.CODABAR!,
];

function handleMarked(event: any) {
    const code = (event.detail?.message || '').trim();
    if (scanResultHandled || !code) return;
    scanResultHandled = true;
    stopScanner();
    uni.$emit('device-scan-marked', {
        code,
        type: event.detail?.type === plus.barcode.QR ? 'qrCode' : 'barCode',
    });
}

function stopScanner() {
    if (!scannerActive) return;
    scannerActive = false;
    if (torchEnabled) {
        scannerRef.value?.setFlash(false);
        torchEnabled = false;
    }
    scannerRef.value?.cancel();
}

function startScanner() {
    if (scannerActive || scanResultHandled) return;
    const scanner = scannerRef.value;
    if (!scanner) {
        uni.showToast({ title: '摄像头初始化失败，请重新进入扫码页', icon: 'none' });
        return;
    }
    scannerActive = true;
    scanner.start({ conserve: false, vibrate: true, sound: 'default' });
}

function handleError(event: any) {
    console.error('原生扫码启动失败', event.detail);
    stopScanner();
    uni.showToast({ title: '无法使用摄像头，请检查相机权限后重试', icon: 'none' });
}

function handleConfig(data: any) {
    if (data.action === 'stop') {
        stopScanner();
        return;
    }
    if (data.action === 'flash') {
        if (!scannerActive) {
            uni.showToast({ title: '摄像头尚未就绪，请稍后重试', icon: 'none' });
            return;
        }
        torchEnabled = Boolean(data.enabled);
        scannerRef.value?.setFlash(torchEnabled);
        return;
    }
    if (data.action === 'start') {
        startScanner();
    }
}

onLoad(() => {
    uni.$on('device-scan-config', handleConfig);
});

onUnload(() => {
    stopScanner();
    uni.$off('device-scan-config', handleConfig);
});
</script>

<template>
    <view class="preview">
        <barcode ref="scannerRef" class="camera" :autostart="false" :filters="scanFilters"
            backgroud="#000000" frameColor="rgba(0,0,0,0)" scanbarColor="rgba(0,0,0,0)" @marked="handleMarked" @error="handleError"></barcode>
        <view class="scan-guide">
            <view class="guide-corner top-left"></view>
            <view class="guide-corner top-right"></view>
            <view class="guide-corner bottom-left"></view>
            <view class="guide-corner bottom-right"></view>
            <view class="guide-line"></view>
        </view>
    </view>
</template>

<style scoped>
.preview {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #000000;
}
.camera {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
.scan-guide {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 12px;
    bottom: 12px;
}
.guide-corner {
    position: absolute;
    width: 21px;
    height: 21px;
    border-color: #78A9FF;
}
.top-left {
    left: 0;
    top: 0;
    border-left-width: 3px;
    border-top-width: 3px;
}
.top-right {
    right: 0;
    top: 0;
    border-right-width: 3px;
    border-top-width: 3px;
}
.bottom-left {
    left: 0;
    bottom: 0;
    border-left-width: 3px;
    border-bottom-width: 3px;
}
.bottom-right {
    right: 0;
    bottom: 0;
    border-right-width: 3px;
    border-bottom-width: 3px;
}
.guide-line {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 60px;
    height: 2px;
    background-color: #5D9BFF;
}
</style>
